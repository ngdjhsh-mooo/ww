local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local Network = ReplicatedStorage:WaitForChild("Network")
local LocalPlayer = Players.LocalPlayer

-- CẤU HÌNH TỐI ƯU TỐC ĐỘ
local TARGET_PLACE_ID = 8737899170
local HOP_TIME = 600          -- giữ nguyên nếu cần, nhưng có thể giảm xuống 60 để test
local THREAD_COUNT = 8        -- tăng lên 8 luồng để bão hòa pipeline
local DELAY_TIME = 0          -- không delay, gọi liên tục
local isWorking = true

local spawn = task.spawn
local wait = task.wait

local Unlock = Network.SecretRoom_Unlock
local Enter = Network.Instancing_PlayerEnterInstance
local Custom = Network.Instancing_InvokeCustomFromClient
local Leave = Network.Instancing_PlayerLeaveInstance

local Invk = Unlock.InvokeServer
local Fire = Leave.FireServer

local S_CR1, S_CR2, S_SC = "Chest Roulette", "ChestRoulette", "SelectChest"

-- Hàm xả đạn - gọi đồng bộ tuần tự thay vì spawn lồng nhau để tránh overhead tạo thread
local function UltraBurstFire()
    Invk(Unlock, S_CR1) 
    Invk(Enter, S_CR2) 
    Invk(Custom, S_CR2, S_SC, 2) 
    Fire(Leave, S_CR2)
end

-- Hàm nhảy Server - rút gọn tối đa
local function FastServerHop()
    isWorking = false
    RunService:Set3dRenderingEnabled(true)
    wait(0.5)  -- giảm từ 2s xuống 0.5s, chỉ đủ để giải phóng buffer
    TeleportService:Teleport(TARGET_PLACE_ID, LocalPlayer)
    -- Không cần delay retry, nếu treo thì retry 1 lần sau 2s
    task.delay(2, function() TeleportService:Teleport(TARGET_PLACE_ID, LocalPlayer) end)
end

-- KHỞI TẠO - tắt render ngay lập tức, không đợi 5s
RunService:Set3dRenderingEnabled(false) 
settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.Disabled

-- Dọn rác mỗi 10s thay vì 30s để giữ RAM thoáng
task.spawn(function()
    while isWorking do
        wait(10)
        collectgarbage("collect")
    end
end)

-- Đặt lịch hop
task.delay(HOP_TIME, FastServerHop)

-- Chạy luồng bắn phá với số luồng tối đa, KHÔNG delay giữa các lần gọi
for i = 1, THREAD_COUNT do
    spawn(function()
        while isWorking do
            UltraBurstFire()
            -- Không có wait() => gọi liên tục đến khi server trả về hoặc bị giới hạn rate
        end
    end)
end

-- UI hiển thị (không ảnh hưởng tốc độ chính)
local ScreenGui = Instance.new("ScreenGui", CoreGui)
local Label = Instance.new("TextLabel", ScreenGui)
Label.Size = UDim2.new(0, 200, 0, 40)
Label.Position = UDim2.new(0.02, 0, 0.05, 0)
Label.BackgroundColor3 = Color3.fromRGB(0,0,0)
Label.TextColor3 = Color3.fromRGB(255,255,0)
Label.Font = Enum.Font.Code
Label.TextScaled = true

spawn(function()
    local start = tick()
    while isWorking do
        local remain = math.max(0, HOP_TIME - (tick()-start))
        Label.Text = "⚡ BURST: " .. remain .. "s"
        wait(0.5)  -- cập nhật UI 2Hz, đủ nhanh
    end
end)
